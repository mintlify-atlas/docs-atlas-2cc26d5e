  "keyFeatures": [
    "100% VK API coverage with 1:1 method mapping",
    "Written in TypeScript with full type definitions",
    "Support for Long Poll (User & Bots) and Callback API",
    "Automatic request parallelization and rate limiting",
    "Built-in keyboard builder and file upload utilities",
    "Middleware-based event handling",
    "Native ESM and CommonJS support",
    "User authorization including login/password flow",
    "Rich ecosystem with session, scenes, and streaming modules"
  ],
  "publicApiSurface": [
    "VK - Main class providing unified interface",
    "API - VK API methods with automatic type mapping",
    "Updates - Event handling for Long Poll and Webhook",
    "Upload - File upload utilities for various attachment types",
    "Keyboard - Keyboard builder with chainable API",
    "MessageContext - Context for message events",
    "Attachment classes - Photo, Video, Document, etc.",
    "Collect - Iterator utilities for paginated API requests",
    "@vk-io/authorization - Authorization flows",
    "@vk-io/session - Session management",
    "@vk-io/scenes - Scene-based conversation flows",
    "@vk-io/streaming - Streaming API client",
    "@vk-io/hear - Text matching middleware",
    "@vk-io/stateless-prompt - Stateless prompts"
  ]
